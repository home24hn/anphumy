# Copy this file to .env.local and fill in your Supabase project's values.
# Project Settings > API in the Supabase dashboard.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Only needed by scripts run outside the app (e.g. seeding). Never expose this
# in client code and never commit it. Do not set it unless you specifically
# need to bypass RLS from a trusted server context.
# SUPABASE_SERVICE_ROLE_KEY=
